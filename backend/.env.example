# Brevo SMTP credentials — used to send real verification code emails.
# Sign up at brevo.com, verify a sender address, then get these from
# Settings > SMTP & API > API tab.
SECRET_KEY=
BREVO_API_KEY=
SMTP_SENDER=

# When true, the email-code response includes "demoCode" so you can
# sign in without checking a real inbox. Leave true for local dev,
# set to false in production.
DEMO_ALLOWED_EMAILS=
DEMO_MODE=true